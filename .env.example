# Copy to .env.local (dev) or .env (docker compose) and fill in.
# In production set these in the Liara dashboard instead.

# talasea | mock. Unset → talasea in production, mock in development.
# In production an unknown value, or mock, serves NO prices and /api/health returns 503.
PRICE_PROVIDER=mock
# Staging only: permit PRICE_PROVIDER=mock in a production build. Never on the real site.
ALLOW_MOCK_IN_PRODUCTION=false

# Public https origin, used for canonical/OG/sitemap/robots (read at runtime).
SITE_URL=http://localhost:3000

# Elyasian spread in integer rials (50,000 toman = 500,000 rials).
# Buy must not exceed sell, otherwise prices are frozen automatically.
PRICE_ADJ_SELL_RIALS=500000
PRICE_ADJ_BUY_RIALS=-500000
PRICE_ADJ_ITEMS=gold_18

# true → withhold Elyasian buy/sell and show the freeze banner.
PRICE_FREEZE=false

# Seconds after the last successful fetch before the UI warns and /api/health returns 503.
STALE_WARN_SECONDS=600

# Optional Telegram staleness alert (off when unset).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
